<?xml version="1.0"?>
<package format="3">

    <!-- Package Information -->
    <name>ov_eval</name>
    <version>1.0.0</version>
    <description>
        Evaluation methods and scripts for visual-inertial odometry systems.
    </description>
    <url type="website">https://github.com/Yuantai-Z/FF-VIO-Init</url>
    <url type="bugtracker">https://github.com/Yuantai-Z/FF-VIO-Init/issues</url>
    <url type="repository">https://github.com/Yuantai-Z/FF-VIO-Init</url>

    <!-- Code Authors -->
    <author email="pgeneva@udel.edu">Patrick Geneva</author>
    <author email="keck@udel.edu">Kevin Eckenhoff</author>
    <author email="ghuang@udel.edu">Guoquan Huang</author>
    <author email="tai0515nice@163.com">Yuantai-Z</author>
    <maintainer email="tai0515nice@163.com">Yuantai-Z</maintainer>

    <!-- Licensing -->
    <license>GNU General Public License v3.0</license>

    <!-- ROS 1 dependencies. -->
    <buildtool_depend>catkin</buildtool_depend>
    <depend>cmake_modules</depend>
    <depend>roscpp</depend>
    <depend>rospy</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>ov_core</depend>
    <exec_depend>rosbag</exec_depend>

    <!-- System dependencies for both versions -->
    <depend>eigen</depend>
    <depend>boost</depend>

    <!-- Note the export is required to expose the executables -->
    <export>
        <build_type>catkin</build_type>
        <rosdoc config="rosdoc.yaml" />
    </export>

</package>
